rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net - Deny-all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Dynamic Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Products collection rules
    match /products/{productId} {
      allow read: if true; // Anyone can read products catalog
      allow write: if false; // Writes must pass safely through admin panel
    }

    // 3. Orders collection rules
    match /orders/{orderId} {
      // Customers can submit an order if they supply contact fields
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && request.resource.data.address is string
                    && request.resource.data.address.size() > 0
                    && request.resource.data.email is string
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      // Allow reading if requested under the verified order ID (single tracking lookup)
      allow get: if true;
      allow list, update, delete: if false; // Block client-side list scraping of customer fields
    }

    // 4. Coupons rules
    match /coupons/{couponId} {
      allow read: if true; // Readers can fetch coupon percentage
      allow write: if false;
    }

    // 5. Reviews collection
    match /reviews/{reviewId} {
      allow read: if true; // Visible to public
      allow create: if request.resource.data.reviewerName is string
                    && request.resource.data.comment is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // 6. Newsletter subscriptions
    match /newsletter/{subId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() > 0;
      allow read, update, delete: if false;
    }

    // 7. Site & Payment configurations
    match /settings/{settingsDocId} {
      allow read: if true; // Required for public UI theme loading
      allow write: if false; // Block client-side write access
    }
  }
}
